# Core
SPREADSHEET_ID=YOUR_GOOGLE_SHEET_ID
TIMEZONE=Asia/Ho_Chi_Minh
POLL_SECONDS=20
DRY_RUN=true
PUBLISH_TRANSPORT=ANDROID

# Android companion API
ANDROID_API_TOKEN=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARS
ANDROID_PILOT_SAFE_MODE=true
ANDROID_CLAIM_LEASE_SEC=1200
ANDROID_MAX_MEDIA_BYTES=262144000

# Google authentication
GOOGLE_AUTH_MODE=AUTO
GOOGLE_OAUTH_CREDENTIALS_JSON={}
# Legacy/fallback service account mode
GOOGLE_SERVICE_ACCOUNT_JSON={}

# Local runtime path
WORK_DIR=/tmp/facebook-story-worker
