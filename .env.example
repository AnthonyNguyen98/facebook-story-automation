# Core
SPREADSHEET_ID=YOUR_GOOGLE_SHEET_ID
TIMEZONE=Asia/Ho_Chi_Minh
POLL_SECONDS=20
DRY_RUN=true

# Google authentication
GOOGLE_AUTH_MODE=AUTO
GOOGLE_OAUTH_CREDENTIALS_JSON={}
# Legacy/fallback service account mode
GOOGLE_SERVICE_ACCOUNT_JSON={}

# Meta Business Suite
META_BUSINESS_URL=https://business.facebook.com/latest/home
META_STORAGE_STATE_PATH=/data/meta_storage_state.json
META_STORAGE_STATE_B64=
STRICT_LINK_TEXT=true
HEADLESS=true

# Local / volume paths
WORK_DIR=/tmp/facebook-story-worker
SESSION_DIR=/data
